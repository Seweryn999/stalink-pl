# Skopiuj ten plik do .env.local i uzupelnij prawdziwymi wartosciami.
# .env.local NIE moze trafic do repozytorium - jest ignorowany przez .gitignore.

# --- Gemini (chatbot) ---
# Uzywany WYLACZNIE po stronie serwera w lib/gemini.ts.
# Nigdy nie dodawaj do niego prefiksu NEXT_PUBLIC_.
GEMINI_API_KEY=

# --- Firebase Admin (archiwum wiadomosci z formularza w Firestore) ---
# Dane service accountu. FIREBASE_PRIVATE_KEY to klucz prywatny w jednej linii,
# z lamaniem linii zapisanym jako \n, calosc w cudzyslowach.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Resend (powiadomienie mailowe o nowej wiadomosci) ---
# CONTACT_FROM_EMAIL musi byc adresem z domeny zweryfikowanej w Resend,
# np. "STALINK <kontakt@stalink.pl>". CONTACT_TO_EMAIL to Twoja skrzynka.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Analityka i weryfikacja (wartosci publiczne, nie sa sekretami) ---
GOOGLE_SITE_VERIFICATION=
GOOGLE_ANALYTICS_ID=
