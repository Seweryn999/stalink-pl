rules_version = '2';

// Strona stalink.pl korzysta z Firestore wylacznie przez Firebase Admin SDK
// po stronie serwera (route handlery Next.js). Admin SDK omija te reguly,
// wiec calkowita blokada dostepu klienckiego niczego nie psuje, a zamyka
// odczyt i zapis kolekcji `messages` z przegladarki.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
